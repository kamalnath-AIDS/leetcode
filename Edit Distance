class Solution {
public:
    int minDistance(string word1, string word2) {
        int m = word1.size();
        int n = word2.size();

        vector<vector<int>> dp(m + 1, vector<int>(n + 1));

        // Empty word2: delete all characters from word1
        for (int i = 0; i <= m; i++) {
            dp[i][0] = i;
        }

        // Empty word1: insert all characters of word2
        for (int j = 0; j <= n; j++) {
            dp[0][j] = j;
        }

        for (int i = 1; i <= m; i++) {
            for (int j = 1; j <= n; j++) {

                if (word1[i - 1] == word2[j - 1]) {
                    // Characters are same
                    dp[i][j] = dp[i - 1][j - 1];
                }
                else {
                    // Insert, Delete, Replace
                    dp[i][j] = 1 + min({
                        dp[i][j - 1],     // Insert
                        dp[i - 1][j],     // Delete
                        dp[i - 1][j - 1]  // Replace
                    });
                }
            }
        }

        return dp[m][n];
    }
};
