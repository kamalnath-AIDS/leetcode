class Solution {
public:
    string simplifyPath(string path) {
        vector<string> st;
        string temp;

        for (int i = 0; i <= path.size(); i++) {
            if (i == path.size() || path[i] == '/') {

                if (temp == "" || temp == ".") {
                    // Ignore empty parts and "."
                }
                else if (temp == "..") {
                    // Go to parent directory
                    if (!st.empty()) {
                        st.pop_back();
                    }
                }
                else {
                    // Valid directory/file name
                    st.push_back(temp);
                }

                temp = "";
            }
            else {
                temp += path[i];
            }
        }

        string result = "/";

        for (int i = 0; i < st.size(); i++) {
            result += st[i];

            if (i != st.size() - 1) {
                result += "/";
            }
        }

        return result;
    }
};
